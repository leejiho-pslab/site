# ===========================================================
#  로컬 실행용 환경변수 예시. 복사해서 .env 로 사용하거나
#  GitHub Actions 의 Secrets/Variables 에 등록하세요.
#  (.env 는 .gitignore 에 포함되어 커밋되지 않습니다)
# ===========================================================

# --- 콘텐츠 생성 (필수) ---
ANTHROPIC_API_KEY=sk-ant-...
CONTENT_MODEL=claude-sonnet-4-6

# --- 사이트 배포 ---
# GitHub Pages 프로젝트 페이지: https://<user>.github.io/<repo>
SITE_URL=https://leejiho-pslab.github.io/site
SITE_BASE_PATH=/site
# 커스텀 도메인 사용 시 (예: ttip.example.com) — 설정하면 CNAME 자동 생성, base_path 는 "" 로
# SITE_CNAME=
# SITE_BASE_PATH=

# --- 광고: 애드센스 ---
ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT_TOP=
ADSENSE_SLOT_INARTICLE=
ADSENSE_SLOT_BOTTOM=
ADSENSE_SLOT_SIDEBAR=

# --- 광고: 타뷸라 ---
TABOOLA_PUBLISHER=
TABOOLA_PLACEMENT=Below Article Thumbnails
TABOOLA_MODE=thumbnails-a

# --- 광고: 네이버(디스플레이 스크립트, 선택) ---
# NAVER_AD_SCRIPT=

# --- 제휴 마케팅: 쿠팡 파트너스 / 네이버 쇼핑 파트너 (선택) ---
# 가입: https://partners.coupang.com / https://shoppartner.naver.com
COUPANG_PARTNER_ID=
NAVER_PARTNER_ID=

# --- 분석/검증 ---
GA4_ID=
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# --- 발행 정책 ---
POSTS_PER_RUN=1

# --- IndexNow (즉시 인덱싱, 선택) ---
# 임의의 영숫자 32자 내외 키. 설정 시 public/<KEY>.txt 생성 + 발행 때 자동 핑
INDEXNOW_KEY=

# --- 구글 블로거 연동 (선택) ---
BLOGGER_BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
PUBLISH_BLOGGER=false
